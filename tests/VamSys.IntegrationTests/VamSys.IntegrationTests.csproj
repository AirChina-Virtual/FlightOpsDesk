<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../VamSys.TestSupport/VamSys.TestSupport.csproj" />
    <ProjectReference Include="../../src/VamSys.Storage/VamSys.Storage.csproj" AdditionalProperties="VamSysTestSupport=true" />
    <ProjectReference Include="../../src/VamSys.Infrastructure/VamSys.Infrastructure.csproj" AdditionalProperties="VamSysTestSupport=true" />
    <!-- The package check lives in the QA tool; Packaging/PackageChecksTests calls it directly. -->
    <ProjectReference Include="../../tools/VamSys.QaSeed/VamSys.QaSeed.csproj" />
  </ItemGroup>
  <ItemGroup><Using Include="Xunit" /></ItemGroup>
  <!-- The child process of the real-termination tests: built first, then copied to <output>/ProcessChild (run as `dotnet VamSys.ProcessChild.dll`). -->
  <ItemGroup>
    <ProjectReference Include="../VamSys.ProcessChild/VamSys.ProcessChild.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="../VamSys.ProcessChild/Wire.cs" Link="Storage/ProcessTermination/Wire.cs" />
  </ItemGroup>
  <Target Name="CopyProcessChild" AfterTargets="Build">
    <ItemGroup>
      <ProcessChildFile Include="../VamSys.ProcessChild/bin/$(Configuration)/$(TargetFramework)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProcessChildFile)" DestinationFiles="@(ProcessChildFile->'$(OutDir)ProcessChild/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup><None Update="Fixtures/**/*.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
