<Project Sdk="Microsoft.NET.Sdk">
  <!-- Performance benchmarks (the benchmark command-line entries), separate from the regression tests: they measure and
       write JSON, they do not pass or fail on timings. Built against the test-support storage build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VamSys.TestSupport/VamSys.TestSupport.csproj" />
    <ProjectReference Include="../../src/VamSys.Storage/VamSys.Storage.csproj" AdditionalProperties="VamSysTestSupport=true" />
    <ProjectReference Include="../../src/VamSys.Infrastructure/VamSys.Infrastructure.csproj" AdditionalProperties="VamSysTestSupport=true" />
    <ProjectReference Include="../../src/VamSys.Presentation/VamSys.Presentation.csproj" AdditionalProperties="VamSysTestSupport=true" />
  </ItemGroup>
  <ItemGroup><Using Include="VamSys.TestSupport" /></ItemGroup>
</Project>
