<Project Sdk="Microsoft.NET.Sdk">
  <!-- Command-line QA tool: seeds isolated data for the window tests, asserts what they left after a restart, checks the
       product and QA packages, and exports diagnostic replays. Built against the test-support storage build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../tests/VamSys.TestSupport/VamSys.TestSupport.csproj" />
    <ProjectReference Include="../../src/VamSys.Storage/VamSys.Storage.csproj" AdditionalProperties="VamSysTestSupport=true" />
    <ProjectReference Include="../../src/VamSys.Infrastructure/VamSys.Infrastructure.csproj" AdditionalProperties="VamSysTestSupport=true" />
  </ItemGroup>
  <ItemGroup><Using Include="VamSys.TestSupport" /></ItemGroup>
</Project>
