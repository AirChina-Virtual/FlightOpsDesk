<UserControl x:Class="VamSys.App.BatchRuleDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- No x:Name here: WinUI would expose each one as an AutomationId, which the window scripts and the inventory lock. -->
  <StackPanel Spacing="{StaticResource SpacingLarge}">
    <TextBlock Text="{x:Bind Model.Targets}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"/>
    <ComboBox Header="{x:Bind Model.FieldHeader}" ItemsSource="{x:Bind Model.Fields}" SelectedIndex="{x:Bind Model.FieldIndex, Mode=TwoWay}"
        MinWidth="{StaticResource RuleFieldPickerMinWidth}" IsEnabled="{x:Bind Model.CanChooseField, Mode=OneWay}"/>
    <ComboBox Header="{x:Bind Model.KindHeader}" ItemsSource="{x:Bind Model.Kinds}" SelectedIndex="{x:Bind Model.KindIndex, Mode=TwoWay}"/>
    <TextBox Header="{x:Bind Model.FindHeader}" Text="{x:Bind Model.Find, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBox Header="{x:Bind Model.ValueHeader}" Text="{x:Bind Model.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
  </StackPanel>
</UserControl>
