<UserControl x:Class="VamSys.App.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VamSys.App"
    xmlns:vm="using:VamSys.Presentation">
  <!-- No x:Name here: WinUI would expose each one as an AutomationId, which the window scripts and the inventory lock. -->
  <UserControl.Resources>
    <local:ReviewRowTemplateSelector x:Key="RowTemplates">
      <local:ReviewRowTemplateSelector.Heading>
        <DataTemplate x:DataType="vm:ReviewRowViewModel">
          <StackPanel Spacing="{StaticResource SpacingSmall}" Margin="{StaticResource ReviewGroupMargin}">
            <TextBlock Text="{x:Bind Heading, Mode=OneWay}" FontSize="{StaticResource SectionFontSize}"/>
            <Button Content="{x:Bind ExportLabel, Mode=OneWay}" Command="{x:Bind ExportCommand}" HorizontalAlignment="Left"/>
          </StackPanel>
        </DataTemplate>
      </local:ReviewRowTemplateSelector.Heading>
      <local:ReviewRowTemplateSelector.Change>
        <DataTemplate x:DataType="vm:ReviewRowViewModel">
          <StackPanel Spacing="{StaticResource SpacingTight}" Margin="{StaticResource ReviewItemMargin}">
            <TextBlock Text="{x:Bind State, Mode=OneWay}" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Bind Body, Mode=OneWay}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind Reason, Mode=OneWay}" TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate>
      </local:ReviewRowTemplateSelector.Change>
    </local:ReviewRowTemplateSelector>
  </UserControl.Resources>
  <Grid>
    <!-- Shown at once; the plan is built on a worker and the content replaces this when it is ready. -->
    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingLarge}" Visibility="{x:Bind Model.IsPreparing, Mode=OneWay}">
      <ProgressRing IsActive="{x:Bind Model.IsPreparing, Mode=OneWay}" Width="{StaticResource InlineProgressSize}" Height="{StaticResource InlineProgressSize}"/>
      <TextBlock Text="{x:Bind Model.PreparingText, Mode=OneWay}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid RowSpacing="{StaticResource SpacingRelaxed}" Visibility="{x:Bind Model.IsShown, Mode=OneWay}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Spacing="{StaticResource SpacingLarge}">
        <TextBlock Text="{x:Bind Model.Title, Mode=OneWay}" FontSize="{StaticResource SubsectionFontSize}" TextWrapping="Wrap"/>
        <TextBlock Text="{x:Bind Model.Target, Mode=OneWay}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"/>
        <TextBlock Text="{x:Bind Model.Counts, Mode=OneWay}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"/>
        <TextBlock Text="{x:Bind Model.Mode, Mode=OneWay}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"/>
        <TextBlock Text="{x:Bind Model.ConnectHint, Mode=OneWay}" Visibility="{x:Bind Model.ShowsConnectHint, Mode=OneWay}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"/>
        <!-- Collapsed when empty: a visible empty list would still take one spacing in this panel. -->
        <ItemsControl ItemsSource="{x:Bind Model.ShownBlockers, Mode=OneWay}" Visibility="{x:Bind Model.ShowsBlockers, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="{StaticResource SpacingLarge}"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{x:Bind}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="{x:Bind Model.IssuesLabel, Mode=OneWay}" Visibility="{x:Bind Model.ShowsIssues, Mode=OneWay}" Click="ShowIssues"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingLarge}">
            <Button Content="{x:Bind Model.SubmitLabel, Mode=OneWay}" IsEnabled="{x:Bind Model.CanSubmit, Mode=OneWay}" Click="Submit"/>
            <Button Content="{x:Bind Model.ConflictsLabel, Mode=OneWay}" IsEnabled="{x:Bind Model.CanResolveConflicts, Mode=OneWay}" Click="ResolveConflicts"/>
          </StackPanel>
        </ScrollViewer>
        <TextBlock Text="{x:Bind Model.NothingToReview, Mode=OneWay}" Visibility="{x:Bind Model.ShowsNothingToReview, Mode=OneWay}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"/>
      </StackPanel>
      <ListView Grid.Row="1" AutomationProperties.AutomationId="WorkspaceReview" ItemsSource="{x:Bind Model.Rows, Mode=OneWay}"
          ItemTemplateSelector="{StaticResource RowTemplates}" SelectionMode="None" HorizontalContentAlignment="Stretch"/>
    </Grid>
  </Grid>
</UserControl>
