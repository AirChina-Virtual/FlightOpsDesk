<Window x:Class="VamSys.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
  <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="FlightOps Desk" IsPaneToggleButtonVisible="True" PaneToggleRequested="ToggleNavigation">
      <TitleBar.IconSource><BitmapIconSource UriSource="ms-appx:///Assets/FlightOpsDesk.png" ShowAsMonochrome="False"/></TitleBar.IconSource>
      <TitleBar.Content>
        <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox x:Name="WorkspacePicker" Width="{StaticResource WorkspacePickerWidth}" Margin="{StaticResource WorkspacePickerMargin}" VerticalAlignment="Center" DisplayMemberPath="Name" SelectionChanged="WorkspaceChanged"/>
        <Border CornerRadius="{StaticResource BadgeCornerRadius}" Padding="{StaticResource BadgePadding}" Background="{ThemeResource BadgeBackgroundBrush}" VerticalAlignment="Center"><TextBlock x:Name="ModeBadge" FontSize="{StaticResource BadgeFontSize}"/></Border>
        </StackPanel>
      </TitleBar.Content>
    </TitleBar>
    <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" PaneDisplayMode="Auto" OpenPaneLength="190" SelectionChanged="Navigate">
      <NavigationView.MenuItems>
        <NavigationViewItem Tag="workspace" Icon="Home"/>
        <NavigationViewItem Tag="data" Icon="Library"/>
        <NavigationViewItem Tag="import" Icon="Import"/>
        <NavigationViewItem Tag="review" Icon="Edit"/>
        <NavigationViewItem Tag="tasks" Icon="List"/>
        <NavigationViewItem Tag="settings" Icon="Setting"/>
      </NavigationView.MenuItems>
      <Grid x:Name="BodyGrid" Margin="{StaticResource PageMargin}" RowSpacing="{StaticResource SpacingPage}" ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="PageTitle" FontSize="{StaticResource PageTitleFontSize}" FontWeight="SemiBold"/>
        <StackPanel x:Name="ResourceBar" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="{StaticResource SpacingLarge}" VerticalAlignment="Center">
          <ComboBox x:Name="ResourcePicker" Width="{StaticResource ResourcePickerWidth}" SelectionChanged="ResourceChanged"/>
          <TextBlock x:Name="SnapshotLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SecondaryTextBrush}"/>
        </StackPanel>
        <ContentControl x:Name="PageHost" Grid.Row="2" Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </Grid>
    </NavigationView>
    <Grid Grid.Row="2" Padding="{StaticResource StatusBarPadding}" ColumnSpacing="{StaticResource SpacingLarge}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ProgressRing x:Name="BusyRing" Width="{StaticResource BusyIndicatorSize}" Height="{StaticResource BusyIndicatorSize}" IsActive="False"/>
      <TextBlock x:Name="StatusLabel" Grid.Column="1" TextWrapping="Wrap"/>
    </Grid>
  </Grid>
</Window>
