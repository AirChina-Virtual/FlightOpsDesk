<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Design tokens: pages and templates reference these instead of literal sizes and brushes.
       Code reads them through UiTokens; ThemeTokenTests keeps both lists in step. -->

  <!-- Brushes: aliases of the WinUI theme brushes, defined per theme so light, dark and high contrast switch together. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <StaticResource x:Key="CardStrokeBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
      <StaticResource x:Key="DividerBrush" ResourceKey="DividerStrokeColorDefaultBrush"/>
      <StaticResource x:Key="StatusErrorBrush" ResourceKey="SystemFillColorCriticalBrush"/>
      <StaticResource x:Key="ModeOnlineBrush" ResourceKey="SystemFillColorCautionBackgroundBrush"/>
      <StaticResource x:Key="ModeDemoBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush"/>
      <StaticResource x:Key="CardBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
      <StaticResource x:Key="SecondaryTextBrush" ResourceKey="TextFillColorSecondaryBrush"/>
      <StaticResource x:Key="BadgeBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush"/>
      <StaticResource x:Key="CellBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush"/>
      <StaticResource x:Key="CellBackgroundBrush" ResourceKey="ControlFillColorDefaultBrush"/>
      <StaticResource x:Key="CellChangedBrush" ResourceKey="AccentFillColorDefaultBrush"/>
      <StaticResource x:Key="CellChangedBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush"/>
      <StaticResource x:Key="CellIssueBackgroundBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <StaticResource x:Key="CardStrokeBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
      <StaticResource x:Key="DividerBrush" ResourceKey="DividerStrokeColorDefaultBrush"/>
      <StaticResource x:Key="StatusErrorBrush" ResourceKey="SystemFillColorCriticalBrush"/>
      <StaticResource x:Key="ModeOnlineBrush" ResourceKey="SystemFillColorCautionBackgroundBrush"/>
      <StaticResource x:Key="ModeDemoBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush"/>
      <StaticResource x:Key="CardBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
      <StaticResource x:Key="SecondaryTextBrush" ResourceKey="TextFillColorSecondaryBrush"/>
      <StaticResource x:Key="BadgeBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush"/>
      <StaticResource x:Key="CellBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush"/>
      <StaticResource x:Key="CellBackgroundBrush" ResourceKey="ControlFillColorDefaultBrush"/>
      <StaticResource x:Key="CellChangedBrush" ResourceKey="AccentFillColorDefaultBrush"/>
      <StaticResource x:Key="CellChangedBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush"/>
      <StaticResource x:Key="CellIssueBackgroundBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <StaticResource x:Key="CardStrokeBrush" ResourceKey="CardStrokeColorDefaultBrush"/>
      <StaticResource x:Key="DividerBrush" ResourceKey="DividerStrokeColorDefaultBrush"/>
      <StaticResource x:Key="StatusErrorBrush" ResourceKey="SystemFillColorCriticalBrush"/>
      <StaticResource x:Key="ModeOnlineBrush" ResourceKey="SystemFillColorCautionBackgroundBrush"/>
      <StaticResource x:Key="ModeDemoBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush"/>
      <StaticResource x:Key="CardBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
      <StaticResource x:Key="SecondaryTextBrush" ResourceKey="TextFillColorSecondaryBrush"/>
      <StaticResource x:Key="BadgeBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush"/>
      <StaticResource x:Key="CellBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush"/>
      <StaticResource x:Key="CellBackgroundBrush" ResourceKey="ControlFillColorDefaultBrush"/>
      <StaticResource x:Key="CellChangedBrush" ResourceKey="AccentFillColorDefaultBrush"/>
      <StaticResource x:Key="CellChangedBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush"/>
      <StaticResource x:Key="CellIssueBackgroundBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- The one look of a card on every page. -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Padding" Value="20"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}"/>
  </Style>
  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
  </Style>
  <Style x:Key="CardTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- Colours that code switches or sets go through a style: a brush read in code stays in the theme it was read in,
       while a style's ThemeResource follows the element's theme. -->
  <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
  </Style>
  <Style x:Key="StatusTextStyle" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="IsTextSelectionEnabled" Value="True"/>
  </Style>
  <Style x:Key="StatusErrorTextStyle" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="IsTextSelectionEnabled" Value="True"/>
    <Setter Property="Foreground" Value="{ThemeResource StatusErrorBrush}"/>
  </Style>
  <!-- A table cell's box: plain, changed from the server's value, or with a problem the checks found. -->
  <Style x:Key="CellBoxStyle" TargetType="Border">
    <Setter Property="BorderThickness" Value="{StaticResource CellBorderThickness}"/>
    <Setter Property="CornerRadius" Value="{StaticResource CellCornerRadius}"/>
    <Setter Property="Padding" Value="{StaticResource CellBoxPadding}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CellBorderBrush}"/>
    <Setter Property="Background" Value="{ThemeResource CellBackgroundBrush}"/>
  </Style>
  <Style x:Key="CellChangedBoxStyle" TargetType="Border" BasedOn="{StaticResource CellBoxStyle}">
    <Setter Property="BorderThickness" Value="{StaticResource CellMarkedBorderThickness}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CellChangedBrush}"/>
    <Setter Property="Background" Value="{ThemeResource CellChangedBackgroundBrush}"/>
  </Style>
  <Style x:Key="CellIssueBoxStyle" TargetType="Border" BasedOn="{StaticResource CellBoxStyle}">
    <Setter Property="BorderThickness" Value="{StaticResource CellIssueBorderThickness}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource StatusErrorBrush}"/>
    <Setter Property="Background" Value="{ThemeResource CellIssueBackgroundBrush}"/>
  </Style>  <Style x:Key="ModeOfflineBadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource BadgeBackgroundBrush}"/>
  </Style>
  <Style x:Key="ModeDemoBadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource ModeDemoBrush}"/>
  </Style>
  <Style x:Key="ModeOnlineBadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource ModeOnlineBrush}"/>
  </Style>
  <x:Double x:Key="PageContentMaxWidth">960</x:Double>
  <x:Double x:Key="DetailsPaneWidth">360</x:Double>
  <Thickness x:Key="DetailsFieldsPadding">0,0,12,12</Thickness>
  <Thickness x:Key="DetailsLabelMargin">0,8,0,0</Thickness>
  <Thickness x:Key="ResourceRowPadding">20,12</Thickness>
  <x:Double x:Key="StatNumberFontSize">28</x:Double>

  <!-- Type -->
  <x:Double x:Key="BadgeFontSize">12</x:Double>
  <x:Double x:Key="BodyFontSize">14</x:Double>
  <x:Double x:Key="SubtitleFontSize">16</x:Double>
  <x:Double x:Key="CardTitleFontSize">17</x:Double>
  <x:Double x:Key="SubsectionFontSize">18</x:Double>
  <x:Double x:Key="SectionFontSize">20</x:Double>
  <x:Double x:Key="DataPageTitleFontSize">24</x:Double>
  <x:Double x:Key="PageTitleFontSize">28</x:Double>

  <!-- Spacing between stacked or adjacent items -->
  <x:Double x:Key="SpacingTight">4</x:Double>
  <x:Double x:Key="SpacingSmall">6</x:Double>
  <x:Double x:Key="SpacingMedium">8</x:Double>
  <x:Double x:Key="SpacingRelaxed">10</x:Double>
  <x:Double x:Key="SpacingLarge">12</x:Double>
  <x:Double x:Key="SpacingPage">14</x:Double>

  <!-- Margins and padding -->
  <Thickness x:Key="PageMargin">28,20,28,12</Thickness>
  <Thickness x:Key="DataPageMargin">20,12,20,8</Thickness>
  <Thickness x:Key="StatusBarPadding">24,8</Thickness>
  <Thickness x:Key="WorkspacePickerMargin">12,0</Thickness>
  <Thickness x:Key="BadgePadding">10,5</Thickness>
  <Thickness x:Key="StartupErrorMargin">24</Thickness>
  <Thickness x:Key="WorkspaceCardPadding">18</Thickness>
  <Thickness x:Key="TaskCardPadding">16</Thickness>
  <Thickness x:Key="TaskCardMargin">0,6</Thickness>
  <Thickness x:Key="ReviewGroupMargin">0,12,0,6</Thickness>
  <Thickness x:Key="ReviewItemMargin">0,4,0,8</Thickness>
  <Thickness x:Key="IconButtonPadding">7</Thickness>

  <!-- Corners -->
  <CornerRadius x:Key="CellCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="BadgeCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

  <!-- Data table: comfortable and compact density -->
  <x:Double x:Key="DataRowHeightComfortable">40</x:Double>
  <x:Double x:Key="DataRowHeightCompact">32</x:Double>
  <x:Double x:Key="CellHeightComfortable">32</x:Double>
  <x:Double x:Key="CellHeightCompact">28</x:Double>
  <Thickness x:Key="CellMarginComfortable">0,3,6,3</Thickness>
  <Thickness x:Key="CellMarginCompact">0,1,6,1</Thickness>
  <Thickness x:Key="CellBorderThickness">0,0,0,1</Thickness>
  <Thickness x:Key="CellMarkedBorderThickness">0,0,0,2</Thickness>
  <Thickness x:Key="CellIssueBorderThickness">1</Thickness>
  <Thickness x:Key="CellTextPadding">8,0</Thickness>
  <Thickness x:Key="CellBoxPadding">9,0</Thickness>
  <Thickness x:Key="CellButtonPadding">8,2</Thickness>
  <Thickness x:Key="CellEditorPadding">8,2,8,2</Thickness>
  <Thickness x:Key="CellPickerPadding">6,0</Thickness>
  <x:Double x:Key="HintDelayMilliseconds">500</x:Double>
  <Thickness x:Key="ColumnHeaderMargin">0,0,6,0</Thickness>
  <Thickness x:Key="DataHeaderInset">36,0,0,0</Thickness>
  <x:Double x:Key="LockedTableOpacity">0.6</x:Double>

  <!-- Control widths -->
  <x:Double x:Key="WorkspacePickerWidth">230</x:Double>
  <x:Double x:Key="ResourcePickerWidth">160</x:Double>
  <x:Double x:Key="SearchBoxWidth">220</x:Double>
  <x:Double x:Key="FilterPickerWidth">140</x:Double>
  <x:Double x:Key="SortPickerWidth">150</x:Double>
  <x:Double x:Key="DensityPickerWidth">144</x:Double>
  <x:Double x:Key="PageJumpWidth">48</x:Double>
  <x:Double x:Key="PageSizePickerWidth">78</x:Double>
  <x:Double x:Key="SettingsFieldMaxWidth">650</x:Double>
  <x:Double x:Key="LanguagePickerMinWidth">220</x:Double>
  <x:Double x:Key="RuleFieldPickerMinWidth">300</x:Double>
  <x:Double x:Key="WorkspaceChoiceMinWidth">320</x:Double>
  <x:Double x:Key="BusyIndicatorSize">18</x:Double>
  <x:Double x:Key="InlineProgressSize">20</x:Double>

  <!-- Dialog content heights -->
  <x:Double x:Key="FleetChoiceListHeight">180</x:Double>
  <x:Double x:Key="ImportMappingMaxHeight">280</x:Double>
  <x:Double x:Key="DialogListMaxHeight">350</x:Double>
  <x:Double x:Key="BatchPreviewMaxHeight">360</x:Double>
  <x:Double x:Key="FleetPreviewMaxHeight">380</x:Double>
  <x:Double x:Key="ReviewDetailMaxHeight">400</x:Double>
  <x:Double x:Key="TaskDetailMaxHeight">450</x:Double>
</ResourceDictionary>
