<UserControl x:Class="VamSys.App.TaskDetailsDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VamSys.Presentation">
  <!-- No x:Name here: WinUI would expose each one as an AutomationId, which the window scripts and the inventory lock. -->
  <ListView AutomationProperties.AutomationId="TaskDetailsList" ItemsSource="{x:Bind Model.Items}" MaxHeight="{StaticResource TaskDetailMaxHeight}" SelectionMode="Single">
    <ListView.ItemTemplate>
      <!-- Each item refreshes its text while the task runs. -->
      <DataTemplate x:DataType="vm:TaskItemViewModel">
        <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" Padding="8"/>
      </DataTemplate>
    </ListView.ItemTemplate>
  </ListView>
</UserControl>
