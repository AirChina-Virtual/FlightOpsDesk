<UserControl x:Class="VamSys.App.ListDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VamSys.App">
  <!-- No x:Name here: WinUI would expose each one as an AutomationId, which the window scripts and the inventory lock. -->
  <ListView ItemsSource="{x:Bind Model.Items}" MaxHeight="{x:Bind local:DialogViews.MaxHeight(Model.Height)}" SelectionMode="{x:Bind local:DialogViews.Selection(Model.Selectable)}">
    <ListView.Header>
      <ItemsControl ItemsSource="{x:Bind Model.Header}" Visibility="{x:Bind Model.HasHeader}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="{StaticResource SpacingLarge}"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{x:Bind}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ListView.Header>
  </ListView>
</UserControl>
