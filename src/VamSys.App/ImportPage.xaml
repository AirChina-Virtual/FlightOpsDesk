<UserControl x:Class="VamSys.App.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- No x:Name here: WinUI would expose each one as an AutomationId, which the window scripts and the inventory lock. -->
  <StackPanel Spacing="{StaticResource SpacingLarge}">
    <TextBlock Text="{x:Bind Model.Title, Mode=OneWay}" FontSize="{StaticResource SubtitleFontSize}" TextWrapping="Wrap"/>
    <TextBlock Text="{x:Bind Model.Help, Mode=OneWay}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"/>
    <TextBlock Text="{x:Bind Model.WeightHint, Mode=OneWay}" FontSize="{StaticResource BodyFontSize}" TextWrapping="Wrap"/>
    <Button Content="{x:Bind Model.ImportLabel, Mode=OneWay}" Click="Import"/>
    <Button Content="{x:Bind Model.RefreshLabel, Mode=OneWay}" Click="Refresh"/>
  </StackPanel>
</UserControl>
