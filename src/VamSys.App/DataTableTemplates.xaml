<ResourceDictionary x:Class="VamSys.App.DataTableTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VamSys.App"
    xmlns:vm="using:VamSys.Presentation">
  <!-- Compiled bindings: no reflection when rows are realized, recycled or rebound. -->
  <DataTemplate x:Key="RowTemplate" x:DataType="vm:RowViewModel">
    <local:DataRowPresenter Row="{x:Bind}"/>
  </DataTemplate>
  <DataTemplate x:Key="EditorTemplate" x:DataType="vm:CellViewModel">
    <!-- The box's style marks a changed value or a problem. The cell makes its tooltip (which, or why it is read-only)
         on hover: a bound tooltip per cell made page changes three times slower. -->
    <local:EditableCell Cell="{x:Bind}" Width="{x:Bind Width}" Height="{x:Bind Height}" Margin="{x:Bind local:UiTokens.CellMargin(Compact)}" AutomationProperties.Name="{x:Bind Field}">
      <Border Style="{x:Bind local:UiTokens.CellBoxStyle(Look), Mode=OneWay}">
        <TextBlock Text="{x:Bind VisibleText, Mode=OneWay}" Opacity="{x:Bind TextOpacity, Mode=OneWay}" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Border>
    </local:EditableCell>
  </DataTemplate>
  <DataTemplate x:Key="FleetTemplate" x:DataType="vm:CellViewModel">
    <!-- 2.5: a problem (such as a route's fleets that are not approved for its prefixes) outlines the button as it does a
         text cell, and the button's tooltip shows the hint (FleetCell). -->
    <Grid Width="{x:Bind Width}" Height="{x:Bind Height}" Margin="{x:Bind local:UiTokens.CellMargin(Compact)}">
      <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="{StaticResource BodyFontSize}" Padding="{StaticResource CellButtonPadding}" HorizontalContentAlignment="Left"
          IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" Command="{x:Bind ChooseFleet}" AutomationProperties.Name="{x:Bind FleetAutomationName, Mode=OneWay}"
          ToolTipService.ToolTip="{x:Bind Hint, Mode=OneWay}">
        <TextBlock Text="{x:Bind DisplayValue, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
      </Button>
      <Border IsHitTestVisible="False" Visibility="{x:Bind local:FleetCell.IssueShown(Look), Mode=OneWay}" BorderBrush="{ThemeResource StatusErrorBrush}"
          BorderThickness="{StaticResource CellIssueBorderThickness}" CornerRadius="{StaticResource CellCornerRadius}"/>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="StatusTemplate" x:DataType="vm:CellViewModel">
    <TextBlock Width="{x:Bind Width}" Margin="{x:Bind local:UiTokens.CellMargin(Compact)}" Padding="{StaticResource CellTextPadding}" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center" Text="{x:Bind DisplayValue, Mode=OneWay}"/>
  </DataTemplate>
</ResourceDictionary>
